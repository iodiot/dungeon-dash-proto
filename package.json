{
  "name": "dungeon-dash-proto",
  "private": true,
  "version": "0.1.0",
  "description": "Dungeon Dash prototype: a 3D collapsing-dungeon runner",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "sim": "tsx scripts/playout.ts",
    "build": "tsc --noEmit && tsx scripts/playout.ts && vite build",
    "size": "node scripts/size.mjs",
    "preview": "vite preview --host"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iodiot/dungeon-dash-proto.git"
  },
  "license": "MIT",
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
